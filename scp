    local keyBox = Instance.new("TextButton", holder)
    keyBox.Size = UDim2.fromOffset(70,24)
    keyBox.Position = UDim2.new(1,-14,0.5,0)
    keyBox.AnchorPoint = Vector2.new(1,0.5)
    keyBox.BackgroundColor3 = Color3.fromRGB(30,35,50)
    keyBox.TextColor3 = THEME.Text
    keyBox.Font = Enum.Font.GothamBold
    keyBox.TextSize = 12
    keyBox.Text = assignedKey.Name
    round(keyBox,6)

    local stroke = Instance.new("UIStroke", keyBox)
    stroke.Color = Color3.fromRGB(80,140,255)
    stroke.Transparency = 0.4

    -- FLOATING HUD BUTTON
    local floatBtn = Instance.new("TextButton", KeybindContainer)
    floatBtn.Size = UDim2.new(1,0,0,34)
    floatBtn.BackgroundColor3 = Color3.fromRGB(25,30,45)
    floatBtn.Text = ""
    round(floatBtn,8)

    local fStroke = Instance.new("UIStroke", floatBtn)
    fStroke.Color = Color3.fromRGB(70,140,255)
    fStroke.Transparency = 0.5

    local floatLabel = Instance.new("TextLabel", floatBtn)
    floatLabel.Size = UDim2.new(1,-12,1,0)
    floatLabel.Position = UDim2.fromOffset(6,0)
    floatLabel.BackgroundTransparency = 1
    floatLabel.Font = Enum.Font.Gotham
    floatLabel.TextSize = 12
    floatLabel.TextXAlignment = Enum.TextXAlignment.Right
    floatLabel.TextColor3 = Color3.fromRGB(220,230,255)

    -- UPDATE VISUALS
    local function refresh()
        keyBox.Text = assignedKey.Name
        floatLabel.Text = text.."  ["..assignedKey.Name.."]  "..(keyState and "ON" or "OFF")
        floatBtn.BackgroundColor3 = keyState and Color3.fromRGB(35,55,95) or Color3.fromRGB(25,30,45)
    end

    local function toggle()
        keyState = not keyState
        refresh()
        if callback then pcall(callback, keyState) end
    end

    refresh()

    -- KEY PRESS TO TOGGLE
    local inputConn
    inputConn = UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == assignedKey then
                toggle()
            end
        end
    end)

    -- CLICK HUD TO TOGGLE
    floatBtn.MouseButton1Click:Connect(toggle)

    -- CLICK PANEL BUTTON TO REBIND
    keyBox.MouseButton1Click:Connect(function()
        keyBox.Text = "..."
        local rebConn
        rebConn = UIS.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                assignedKey = input.KeyCode
                rebConn:Disconnect()
                refresh()
            end
        end)
    end)

    -- RETURN FUNCTIONS TO CONTROL KEYBIND
    return {
        SetKey = function(key)
            assignedKey = key
            refresh()
        end,
        SetState = function(val)
            keyState = val
            refresh()
            if callback then pcall(callback, keyState) end
        end,
        Toggle = toggle, -- allows external toggling
        GetKey = function() return assignedKey end,
        GetState = function() return keyState end
    }
end



