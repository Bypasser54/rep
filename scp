    lbl.TextColor3 = THEME.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local toggle = Instance.new("Frame", holder)
    toggle.Size = UDim2.fromOffset(44,22)
    toggle.Position = UDim2.new(1, -14, 0.5, 0)
    toggle.AnchorPoint = Vector2.new(1,0.5)
    toggle.BackgroundColor3 = default and THEME.Accent or Color3.fromRGB(60,60,75)
    round(toggle,11)

    local knob = Instance.new("Frame", toggle)
    knob.Size = UDim2.fromOffset(18,18)
    knob.Position = default and UDim2.fromOffset(24,2) or UDim2.fromOffset(2,2)
    knob.BackgroundColor3 = default and Color3.fromRGB(25,25,25) or Color3.new(1,1,1)
    round(knob,9)

    local state = default

    local function setState(val)
        state = val
        TweenService:Create(toggle,TweenInfo.new(0.15),{
            BackgroundColor3 = state and THEME.Accent or Color3.fromRGB(60,60,75)
        }):Play()
        TweenService:Create(knob,TweenInfo.new(0.15),{
            Position = state and UDim2.fromOffset(24,2) or UDim2.fromOffset(2,2),
            BackgroundColor3 = state and Color3.fromRGB(25,25,25) or Color3.new(1,1,1)
        }):Play()
        if callback then callback(state) end
    end

    toggle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            setState(not state)
        end
    end)

    return {SetState=setState, GetState=function() return state end}
end

function Panel:AddDropdown(text, options, callback)
    local holder = Instance.new("Frame", content)
    holder.Size = UDim2.new(1,0,0,38)
    holder.BackgroundColor3 = THEME.Item
    round(holder,6)

    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(1,-30,1,0)
    lbl.Position = UDim2.fromOffset(14,0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextColor3 = THEME.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local selectedText = Instance.new("TextLabel", holder)
    selectedText.Size = UDim2.new(0.5, -14, 1, 0)
    selectedText.Position = UDim2.new(1, -14, 0, 0)
    selectedText.AnchorPoint = Vector2.new(1,0)
    selectedText.BackgroundTransparency = 1
    selectedText.Text = options[1] or ""
    selectedText.Font = Enum.Font.Gotham
    selectedText.TextSize = 12
    selectedText.TextColor3 = THEME.Text
    selectedText.TextXAlignment = Enum.TextXAlignment.Right

    local open = false
    local dropdownFrame
    local current = options[1]

    local function toggleDropdown()
        if open then
            if dropdownFrame then dropdownFrame:Destroy() end
            open = false
        else
            dropdownFrame = Instance.new("Frame", holder)
            dropdownFrame.Size = UDim2.new(1,0,0,#options*28)
            dropdownFrame.Position = UDim2.new(0,0,1,2)
            dropdownFrame.BackgroundColor3 = THEME.Item
            round(dropdownFrame,6)

            for i, option in ipairs(options) do
                local btn = Instance.new("TextButton", dropdownFrame)
                btn.Size = UDim2.new(1,0,0,28)
                btn.Position = UDim2.fromOffset(0,(i-1)*28)
                btn.BackgroundTransparency = 1
                btn.Text = option
                btn.Font = Enum.Font.Gotham
                btn.TextSize = 12
                btn.TextColor3 = THEME.Text

                btn.MouseButton1Click:Connect(function()
                    current = option
                    selectedText.Text = option
                    if callback then callback(option) end
                    toggleDropdown()
                end)
            end

            open = true
        end
    end

    holder.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            toggleDropdown()
        end
    end)

    local function setOption(opt)
        if table.find(options, opt) then
            current = opt
            selectedText.Text = opt
            if callback then callback(opt) end
        end
    end

    return {SetOption=setOption, GetOption=function() return current end}
end




