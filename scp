    -- Slider (spacing adjusted)
    function Panel:AddSlider(text, min, max, default, step, callback)
    step = step or 1 -- default step = 1

    local holder = Instance.new("Frame", content)
    holder.Size = UDim2.new(1,0,0,58)
    holder.BackgroundColor3 = THEME.Item
    round(holder,6)

    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(1,-14,0,20)
    lbl.Position = UDim2.fromOffset(14,6)
    lbl.BackgroundTransparency = 1
    lbl.Text = text..": "..default
    lbl.TextColor3 = THEME.Text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local bar = Instance.new("Frame", holder)
    bar.Size = UDim2.new(1,-28,0,8)
    bar.Position = UDim2.fromOffset(14,38)
    bar.BackgroundColor3 = Color3.fromRGB(60,60,75)
    round(bar,5)

    local fill = Instance.new("Frame", bar)
    fill.BackgroundColor3 = THEME.Accent
    round(fill,5)

    local knob = Instance.new("Frame", bar)
    knob.Size = UDim2.fromOffset(14,14)
    knob.AnchorPoint = Vector2.new(0.5,0.5)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    round(knob,7)

    local sliding = false

    local function setFromValue(val)
        local pct = (val - min) / (max - min)
        fill.Size = UDim2.new(pct,0,1,0)
        knob.Position = UDim2.new(pct,0,0.5,0)
        lbl.Text = text..": "..val
        if callback then callback(val) end
    end

    local function updateFromX(x)
        local pct = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local raw = min + (max - min) * pct

        -- SNAP TO STEP
        local stepped = math.floor(raw / step + 0.5) * step
        stepped = math.clamp(stepped, min, max)

        setFromValue(stepped)
    end

    -- set default
    setFromValue(default)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            SLIDER_ACTIVE = true
            updateFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
            SLIDER_ACTIVE = false
        end
    end)
end




