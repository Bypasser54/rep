    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.TextYAlignment = Enum.TextYAlignment.Top
    descLabel.TextWrapped = true

    -- Tween in
    TweenService:Create(notif, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 300, 0, 60)
    }):Play()

    -- Tween out after duration
    task.delay(duration, function()
        TweenService:Create(notif, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0,0,0,60),
            BackgroundTransparency = 1
        }):Play()
        task.delay(0.25, function()
            notif:Destroy()
        end)
    end)
end




